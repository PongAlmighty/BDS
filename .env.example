# Copy this file to .env (or set BDS_ENV_FILE to point to an external .env file)
# Never commit your real .env.

# Twitch app credentials (https://dev.twitch.tv/console)
TWITCH_APP_ID=
TWITCH_APP_SECRET=

# Your Twitch username (login)
TWITCH_TARGET_CHANNEL=

# Local WebSocket relay port the overlay connects to. This must stay 18765:
# index.html hardcodes that port, and docker-compose.yml maps 18765:18765.
# The ?ws= parameter overrides only the host, not the port.
LOCAL_WS_PORT=18765

# Set to 1 to run relay only (no Twitch connection)
BDS_RELAY_ONLY=0

# Set to 1 to print the resolved config on startup (which .env was loaded, which
# credentials are set, the WS port). Prints no secret values, only whether they
# are present. Useful when the overlay connects but nothing ever drops.
BDS_DEBUG=0

# StrangerTV kiosk corner watcher. Blank disables it. Normally set in
# docker-compose.yml rather than here, since it is not a secret.
KIOSK_STATUS_URL=
KIOSK_POLL_INTERVAL=2

# How many nuts a corner hit drops, and who it is attributed to.
# CORNER_BEANS is a legacy alias still honoured as a fallback, but CORNER_NUTS
# wins if both are set -- the drop has been nuts rather than beans since 5ba6196.
CORNER_NUTS=120
CORNER_USER=CORNER

# Banner text for the drop. This fires BEFORE the corner hit lands (the kiosk warns
# us ~15s ahead), so the wording is anticipatory rather than past tense.
# Overridden per-request by /test/nut?text=
CORNER_TEXT=CORNER INCOMING!

# Also drop on the corner hit itself, which is what we did before the kiosk started
# warning us in advance. Leave off unless you want two drops per corner.
CORNER_DROP_ON_HIT=0

# The warning drop is one oversized nut rather than a shower of small ones, so it
# reads as "look up now" at a glance. Scale is a multiplier on normal nut size;
# much past 10 and it is taller than the screen. CORNER_NUTS still governs the
# on-hit drop when CORNER_DROP_ON_HIT is enabled.
CORNER_WARN_NUTS=1
CORNER_WARN_SCALE=5

# Seconds the warning nut stays on screen before it despawns -- everything else
# lives for 60. It is the cue to go and watch the hit, not something to look at,
# so it clears out well before the hit lands.
CORNER_WARN_LIFETIME=10
