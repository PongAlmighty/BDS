# Copy this file to .env (or set BDS_ENV_FILE to point to an external .env file)
# Never commit your real .env.

# Twitch app credentials (https://dev.twitch.tv/console)
TWITCH_APP_ID=
TWITCH_APP_SECRET=

# Your Twitch username (login)
TWITCH_TARGET_CHANNEL=

# Local WebSocket relay port the overlay connects to. This must stay 18765:
# index.html hardcodes that port, and docker-compose.yml maps 18765:18765.
# The ?ws= parameter overrides only the host, not the port.
LOCAL_WS_PORT=18765

# Set to 1 to run relay only (no Twitch connection)
BDS_RELAY_ONLY=0

# StrangerTV kiosk corner watcher. Blank disables it. Normally set in
# docker-compose.yml rather than here, since it is not a secret.
KIOSK_STATUS_URL=
KIOSK_POLL_INTERVAL=2
CORNER_BEANS=120
CORNER_USER=CORNER
